{
  "name": "erp-followup-prototype",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/main.ts",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:api": "tsc -p server/tsconfig.json",
    "start:prod": "node server/dist/main.js",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "node --import tsx server/bootstrap-production.ts",
    "preview": "vite preview",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "db:seed": "tsx server/prisma/seed.ts",
    "db:seed:local-workers": "tsx --tsconfig server/tsconfig.json scripts/seed-local-workers.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "health:local": "node scripts/check-local-runtime.mjs",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:seed:local-sales": "tsx --tsconfig server/tsconfig.json scripts/seed-local-sales.ts",
    "db:seed:local-designers": "node --import tsx scripts/seed-local-designers.ts",
    "typecheck:mini": "tsc -p mini-program/tsconfig.json --noEmit",
    "check": "npm run db:generate && npm run typecheck && npm run typecheck:mini && npm run build && npm run build:api && npm run test:sites"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@remixicon/react": "^4.9.0",
    "antd": "^6.6.2",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-pg-simple": "^10.0.0",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "^17.2.3",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "js-yaml": "5.4.3",
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "6.4.3"
  }
}
