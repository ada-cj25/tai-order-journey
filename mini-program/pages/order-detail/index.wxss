.detail-shell { padding-bottom: 80rpx; }
.top-spacer { width: 84rpx; }
.identity { margin-top: 36rpx; padding: 34rpx; }
.supply-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 20rpx; padding: 27rpx 30rpx; }
.supply-entry > view { min-width: 0; }
.supply-entry strong, .supply-entry text { display: block; }
.supply-entry strong { font-size: 27rpx; }
.supply-entry text { margin-top: 8rpx; color: #757c78; font-size: 21rpx; line-height: 1.4; }
.supply-entry .supply-entry-arrow { flex: none; color: #0b493d; font-size: 23rpx; font-weight: 700; }
.order-no { font-size: 39rpx; font-weight: 800; margin-bottom: 9rpx; }
.tracking-no { margin-top: 14rpx; color: #a0a3a2; font-size: 22rpx; }
.sales-owner-detail { margin-top: 12rpx; color: #0b6b59; font-size: 23rpx; font-weight: 700; }
.designer-owner-detail { margin-top: 10rpx; color: #575c5a; font-size: 23rpx; font-weight: 650; }
.design-mobile-actions { display: grid; grid-template-columns: 1fr; gap: 16rpx; margin-top: 20rpx; }
.design-mobile-actions.two-actions { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14rpx; }
.design-mobile-actions.two-actions button { width: 100%; min-width: 0; box-sizing: border-box; margin: 0; padding: 0 10rpx; font-size: 26rpx; white-space: nowrap; }
.mock-review { margin-top: 20rpx; padding: 28rpx; }
.mock-review-title { font-size: 28rpx; font-weight: 750; }
.mock-review-note { margin: 12rpx 0 20rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.55; }
.mock-review button { width: 100%; margin: 0; }
.mock-route-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12rpx; }
.mock-route-actions button { width: 100%; min-width: 0; padding: 0 8rpx; font-size: 23rpx; }
.mock-route-actions button:only-child { grid-column: 1 / -1; }
.evidence-summary { margin-top: 24rpx; padding: 30rpx; }
.evidence-head { display: flex; align-items: center; justify-content: space-between; }
.evidence-head strong { font-size: 28rpx; }
.evidence-head text { color: #0b493d; font-size: 22rpx; font-weight: 700; }
.evidence-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 22rpx; }
.evidence-grid view { padding: 20rpx; border-radius: 24rpx; background: #f5f7f6; }
.evidence-grid strong, .evidence-grid text, .evidence-grid small { display: block; }
.evidence-grid strong { color: #0b493d; font-size: 32rpx; }
.evidence-grid text { margin-top: 5rpx; font-size: 23rpx; }
.evidence-grid small { margin-top: 6rpx; color: #8b8d91; font-size: 19rpx; }
.evidence-note { margin-top: 18rpx; color: #858886; font-size: 21rpx; line-height: 1.55; }
.order-area-summary { margin-top: 28rpx; padding-top: 26rpx; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 2rpx solid var(--color-line); }
.order-area-summary view { text-align: center; }
.order-area-summary strong, .order-area-summary text { display: block; }
.order-area-summary strong { color: var(--color-forest); font-size: 30rpx; }
.order-area-summary text { margin-top: 8rpx; color: var(--color-muted); font-size: 20rpx; }
.area-title { margin-bottom: 6rpx; }
.area-hint { margin: 0 4rpx 22rpx; color: var(--color-muted); font-size: 23rpx; }
.area-tabs { width: calc(100vw - 44rpx); margin-right: -44rpx; }
.area-tabs-inner { display: flex; gap: 18rpx; padding-right: 44rpx; }
.area-card { flex: 0 0 386rpx; box-sizing: border-box; padding: 28rpx; border: 3rpx solid transparent; border-radius: 34rpx; background: #fff; box-shadow: 0 8rpx 26rpx rgba(17,17,17,.04); }
.area-card.selected { border-color: var(--color-forest); background: #f6fbf9; }
.area-card-head, .area-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.area-card-head strong { font-size: 34rpx; }
.area-card-head text { color: var(--color-forest); font-size: 28rpx; font-weight: 750; }
.production-no { margin: 15rpx 0 22rpx; color: #727675; font-size: 23rpx; }
.area-card-foot text { overflow: hidden; color: var(--color-muted); font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.area-card-foot strong { flex: none; color: var(--color-forest); font-size: 22rpx; }
.area-detail { margin-top: 24rpx; padding: 36rpx 32rpx; }
.area-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.selected-name { font-size: 46rpx; font-weight: 820; }
.selected-number { margin-top: 9rpx; color: var(--color-muted); font-size: 24rpx; }
.area-percent { display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; border-radius: 50%; background: #eaf8f4; color: var(--color-forest); font-size: 27rpx; font-weight: 800; }
.route-row { margin-top: 24rpx; display: grid; grid-template-columns: 150rpx 1fr; gap: 18rpx; font-size: 25rpx; }
.route-row text { color: var(--color-muted); }
.route-row strong { text-align: right; }
.area-detail progress { margin-top: 28rpx; }
.assembly-package-entry { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16rpx; margin-top: 26rpx; padding: 22rpx; border: 2rpx solid #d7e8e1; border-radius: 20rpx; background: #f7fbf9; }
.assembly-package-entry strong, .assembly-package-entry text { display: block; }
.assembly-package-entry strong { font-size: 25rpx; }
.assembly-package-entry text { margin-top: 6rpx; color: #6b746e; font-size: 20rpx; line-height: 1.35; }
.assembly-package-entry button { margin: 0; padding: 0 18rpx; font-size: 22rpx; }
.workshop-flow { margin-top: 28rpx; padding: 24rpx 22rpx 10rpx; border: 2rpx solid #d6ded9; border-radius: 24rpx; background: #fff; }
.workshop-title { margin-bottom: 8rpx; display: flex; align-items: center; justify-content: space-between; }
.workshop-title strong { font-size: 30rpx; }
.workshop-title text { color: var(--color-muted); font-size: 21rpx; }
.process-row { min-height: 108rpx; display: grid; grid-template-columns: 22rpx 1fr auto; align-items: center; gap: 16rpx; border-bottom: 2rpx solid var(--color-line); }
.process-row:last-child { border-bottom: 0; }
.process-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #d9dcda; }
.process-row.DONE .process-dot { background: var(--color-forest); }
.process-row.READY .process-dot, .process-row.OVERDUE .process-dot { background: var(--color-teal); box-shadow: 0 0 0 8rpx #def6ef; }
.process-main strong, .process-main text { display: block; }
.process-main strong { font-size: 27rpx; }
.process-main text { margin-top: 7rpx; color: var(--color-muted); font-size: 21rpx; }
.process-status { color: #a2a5a4; font-size: 21rpx; }
.process-row.reportable .process-status { padding: 10rpx 17rpx; border-radius: 22rpx; background: #e1f7ef; color: #087963; font-weight: 700; }
.journey-card { margin-top: 28rpx; padding: 40rpx 34rpx; }
.stage-title { font-size: 43rpx; font-weight: 820; margin-bottom: 9rpx; }
.journey-list { margin-top: 36rpx; }
.journey-row { position: relative; min-height: 76rpx; display: grid; grid-template-columns: 36rpx 1fr auto; align-items: start; gap: 16rpx; color: #a2a4a5; }
.journey-row::after { content: ""; position: absolute; left: 11rpx; top: 25rpx; bottom: -4rpx; width: 3rpx; background: #e6e6e4; }
.journey-row:last-child::after { display: none; }
.dot { position: relative; z-index: 1; width: 22rpx; height: 22rpx; border-radius: 11rpx; background: #dedfdd; }
.journey-row.complete .dot { background: var(--color-forest); }
.journey-row.current { color: #111; font-weight: 700; }
.journey-row.current .dot { background: var(--color-teal); box-shadow: 0 0 0 10rpx #dff7f1; }
.state-text { font-size: 23rpx; }
.facts { margin-top: 24rpx; padding: 18rpx 34rpx; }
.facts view { min-height: 82rpx; display: grid; grid-template-columns: 190rpx 1fr; align-items: center; border-bottom: 2rpx solid var(--color-line); font-size: 27rpx; }
.facts view:last-child { border-bottom: 0; }
.facts text { color: var(--color-muted); }
.facts strong { font-weight: 650; }
.risk { color: #ae7411; }
.safe { color: var(--color-forest); }
