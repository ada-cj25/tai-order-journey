.report-shell { padding-bottom: 80rpx; }
.top-spacer { width: 84rpx; }
.loading-card { margin-top: 40rpx; padding: 70rpx 30rpx; color: var(--color-muted); text-align: center; }
.identity-chain { margin-bottom: 24rpx; padding: 24rpx 22rpx; border-radius: 32rpx; background: #eaf6f2; display: grid; grid-template-columns: 1fr auto 1.25fr auto 1fr; align-items: center; gap: 8rpx; }
.identity-chain view:not(.chain-arrow) { min-width: 0; text-align: center; }
.identity-chain text, .identity-chain strong { display: block; }
.identity-chain text { color: #6f7774; font-size: 19rpx; }
.identity-chain strong { margin-top: 7rpx; overflow: hidden; color: var(--color-forest); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.chain-arrow { color: #81918c; font-size: 32rpx; }
.task-context { margin-bottom: 24rpx; padding: 14rpx 30rpx; }
.task-context view { min-height: 76rpx; display: grid; grid-template-columns: 150rpx 1fr; align-items: center; gap: 16rpx; border-bottom: 2rpx solid var(--color-line); font-size: 24rpx; }
.task-context view:last-child { border-bottom: 0; }
.task-context text { color: var(--color-muted); }
.task-context strong { text-align: right; font-weight: 650; }
.current-card { padding: 34rpx 36rpx 38rpx; }
.checkin-card { padding: 34rpx 36rpx; }
.checkin-copy { margin-top: 22rpx; color: #606b65; font-size: 25rpx; line-height: 1.5; }
.current-head { display: flex; align-items: center; justify-content: space-between; color: var(--color-muted); font-size: 24rpx; }
.status-pill { padding: 8rpx 16rpx; border-radius: 20rpx; background: #e5f6f1; color: var(--color-forest); font-size: 21rpx; font-weight: 700; }
.current-quantity { margin: 10rpx 0 27rpx; }
.current-quantity strong { font-size: 58rpx; }
.current-quantity text { color: var(--color-muted); font-size: 29rpx; }
.quick-actions { margin-top: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.quick-actions.single-action { grid-template-columns: 1fr; }
.quick-actions button { height: 86rpx; margin: 0; border-radius: 43rpx; font-size: 27rpx; font-weight: 700; line-height: 86rpx; }
.start-button { background: var(--color-forest); color: #fff; }
.issue-button { background: #fff; color: #333; border: 2rpx solid #cfd1cf; }
.quantity-row { position: relative; }
.quantity-row .form-input { padding-right: 100rpx; }
.unit { position: absolute; right: 30rpx; top: 28rpx; color: var(--color-muted); }
.progress-submit { margin-top: 34rpx; }
.report-action-section { margin-top: 34rpx; padding: 28rpx; border: 2rpx solid #dce9e4; border-radius: 30rpx; background: #fff; }
.report-action-section .form-label { margin-top: 0; }
.partial-section { border-color: #e5e5e2; }
.complete-button { height: 96rpx; margin-top: 22rpx; border-radius: 48rpx; background: #e6f5f0; color: var(--color-forest); font-size: 30rpx; font-weight: 750; line-height: 96rpx; }
.checkin-section { padding: 0; border: 0; background: transparent; }
.checkin-section .complete-button { width: 100%; margin-top: 0; }
