.sales-shell { padding-bottom: 90rpx; }
.top-spacer { width: 84rpx; }
.placeholder { color: var(--color-muted); }
.form-section { margin-bottom: 28rpx; padding: 34rpx; }
.section-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.section-head text { display: flex; align-items: center; justify-content: center; width: 46rpx; height: 46rpx; border-radius: 15rpx; background: #e2f5ef; color: var(--color-forest); font-size: 20rpx; font-weight: 800; }
.section-head strong { font-size: 32rpx; font-weight: 780; }
.section-tip { margin: 14rpx 0 6rpx; color: #6f7473; font-size: 24rpx; line-height: 1.55; }
.payment-section { background: #f3fbf8; border: 2rpx solid #c9eee3; }
.required::before { content: "*"; margin-right: 8rpx; color: #ef5a58; }
.picker-value { justify-content: space-between; }
.picker-value > text:last-child { color: #9b9e9d; font-size: 34rpx; }
.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.field-grid .form-label { white-space: nowrap; }
.compact { padding: 0 22rpx; font-size: 27rpx; }
.money-field { min-height: 96rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 12rpx; box-sizing: border-box; border: 2rpx solid var(--color-line); border-radius: 28rpx; background: #fff; }
.money-field > text { color: #555; font-size: 30rpx; }
.money-field input { min-width: 0; flex: 1; font-size: 29rpx; }
.upload-button { width: 100%; min-height: 114rpx; padding: 20rpx 24rpx; display: flex; align-items: center; gap: 20rpx; border: 2rpx dashed #aeb7b4; border-radius: 28rpx; background: #fff; color: #111; text-align: left; }
.upload-button.uploaded { border-style: solid; border-color: #6ac5b1; background: #fafffd; }
.upload-icon { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 18rpx; background: #e2f5ef; color: var(--color-forest); font-size: 36rpx; }
.upload-button view { min-width: 0; flex: 1; }
.upload-button strong, .upload-button small { display: block; }
.upload-button strong { font-size: 27rpx; font-weight: 700; }
.upload-button small { max-width: 430rpx; margin-top: 8rpx; overflow: hidden; color: var(--color-muted); font-size: 22rpx; font-weight: 400; text-overflow: ellipsis; white-space: nowrap; }
.rush-fields { margin-top: 26rpx; padding-top: 4rpx; border-top: 2rpx solid var(--color-line); }
.short { min-height: 170rpx; }
.submit-note { margin: 6rpx 8rpx 28rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.button-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
