.design-shell { padding-bottom: calc(env(safe-area-inset-bottom) + 80rpx); }
.top-spacer { width: 84rpx; }
.order-card, .form-card { margin-bottom: 24rpx; padding: 30rpx; }
.order-card strong, .order-card text, .order-card small { display: block; overflow-wrap: anywhere; }
.order-card strong { font-size: 34rpx; }
.order-card text { margin-top: 6rpx; color: #0b493d; font-size: 27rpx; font-weight: 700; }
.order-card small { margin-top: 8rpx; color: var(--color-muted); font-size: 23rpx; }
.section-title { margin: 0 0 24rpx; }
.required::before { content: "*"; margin-right: 8rpx; color: #e85a52; }
.hint { margin: -4rpx 0 14rpx; color: var(--color-muted); font-size: 23rpx; line-height: 1.45; }
.form-label { margin-top: 24rpx; }
.form-textarea { min-height: 154rpx; }
.file-button { min-height: 88rpx; padding: 10rpx 20rpx; border: 2rpx dashed #98b5ac; border-radius: 24rpx; background: #f5fbf9; color: #0b493d; font-size: 26rpx; }
.file-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.file-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 76rpx; border-bottom: 2rpx solid #efefed; }
.file-name { min-width: 0; flex: 1; color: #0b493d; font-size: 24rpx; overflow-wrap: anywhere; }
.remove { flex: 0 0 auto; color: #bd5149; font-size: 23rpx; }
.submit-note { margin: 10rpx 6rpx 26rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.5; }
.button-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.button-row button { min-width: 0; font-size: 25rpx; }
