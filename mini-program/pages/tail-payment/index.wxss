.tail-shell { padding-bottom: calc(70rpx + env(safe-area-inset-bottom)); }
.top-spacer { width: 84rpx; }
.tail-order, .tail-form { margin-top: 24rpx; padding: 32rpx; }
.tail-order > strong, .tail-order > text { display: block; }
.tail-order > strong { font-size: 35rpx; }
.tail-order > text { margin-top: 9rpx; color: var(--color-forest); font-size: 25rpx; }
.receivable { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; padding-top: 22rpx; border-top: 2rpx solid var(--color-line); font-size: 26rpx; }
.receivable strong { font-size: 34rpx; color: var(--color-forest); }
.tail-form .form-label { display: block; margin: 26rpx 0 12rpx; font-size: 27rpx; }
.tail-form .form-label:first-child { margin-top: 0; }
.money-field { min-height: 96rpx; padding: 0 22rpx; display: flex; align-items: center; gap: 14rpx; border: 2rpx solid var(--color-line); border-radius: 28rpx; }
.money-field input { flex: 1; min-width: 0; font-size: 29rpx; }
.upload-button { width: 100%; min-height: 100rpx; padding: 16rpx 22rpx; border: 2rpx dashed #aeb7b4; border-radius: 28rpx; background: #fff; text-align: left; font-size: 26rpx; }
.tail-note { margin: 26rpx 8rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }
.submit-button { width: 100%; }
