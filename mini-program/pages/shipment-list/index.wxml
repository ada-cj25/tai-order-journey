<view class="page-shell shipment-list-shell">
  <view class="topbar"><view class="brand-lockup"><image class="brand-logo" src="/assets/brand-logo.png" mode="aspectFill" /><view class="brand-title">发货</view></view></view>
  <view class="page-title">发货订单</view>
  <view class="page-subtitle">先选择订单，再登记对应车次</view>
  <view class="search-field"><icon type="search" size="20" color="#8b8d91" /><input value="{{query}}" bindinput="changeQuery" placeholder="搜索客户、销售编号或跟单号" /></view>
  <view class="filter-row">
    <view class="filter-chip {{filter === 'ready' ? 'active' : ''}}" data-filter="ready" bindtap="changeFilter">可发货 {{counts.ready}}</view>
    <view class="filter-chip {{filter === 'tail' ? 'active' : ''}}" data-filter="tail" bindtap="changeFilter">待尾款 {{counts.tail}}</view>
    <view class="filter-chip {{filter === 'history' ? 'active' : ''}}" data-filter="history" bindtap="changeFilter">发货记录 {{counts.history}}</view>
  </view>
  <view wx:if="{{loading}}" class="surface empty-card">正在加载发货订单…</view>
  <view wx:elif="{{error}}" class="surface empty-card">{{error}}<button class="retry-button" bindtap="loadData">重新加载</button></view>
  <view wx:elif="{{!cards.length}}" class="surface empty-card">{{query ? '没有匹配的订单' : filter === 'ready' ? '当前没有可发货订单' : filter === 'tail' ? '当前没有待核验尾款的发货订单' : '暂无发货记录'}}</view>
  <view class="surface shipment-card" wx:for="{{cards}}" wx:key="orderId">
    <view class="card-head"><view><strong>{{item.customerName}}</strong><text>{{item.salesNumber || item.trackingSerial}}</text></view><view class="status {{filter === 'tail' ? 'waiting' : ''}}">{{item.statusLabel}}</view></view>
    <view class="card-detail">{{item.details}}</view>
    <view wx:if="{{filter === 'history'}}" class="history-rows"><view class="history-row" wx:for="{{item.displayRecords}}" wx:for-item="record" wx:key="id"><strong>{{record.vehicle}}</strong><text>{{record.dateLabel}} · {{record.summary}}</text></view></view>
    <view class="card-foot" data-url="{{item.destination}}" bindtap="openOrder"><text>{{filter === 'history' ? '最近发货 · ' + item.lastShipmentLabel : item.tailPaymentConfirmed ? '尾款已核验' : '尾款待财务核验'}}</text><strong>{{item.actionLabel}} ›</strong></view>
  </view>
</view>
<bottom-nav active="shipment" />
