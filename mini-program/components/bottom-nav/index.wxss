.nav-wrap { position: fixed; z-index: 20; left: 28rpx; right: 28rpx; bottom: 0; }
.nav {
  height: 126rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  border-radius: 52rpx;
  border: 2rpx solid #ececea;
  background-color: #ffffff;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  box-shadow: 0 12rpx 38rpx rgba(17, 17, 17, .07);
}
.nav-item {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #66736e;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
}
.nav-item.active { color: #0b493d; }
.nav-icon {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 9rpx;
  color: inherit;
  box-sizing: border-box;
}
.icon-tracking {
  border: 5rpx solid currentColor;
  border-radius: 7rpx;
}
.icon-line {
  position: absolute;
  left: 7rpx;
  right: 5rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.line-one { top: 6rpx; }
.line-two { top: 14rpx; }
.line-three { top: 22rpx; }
.icon-task {
  border-radius: 8rpx;
  background: currentColor;
}
.check-mark {
  position: absolute;
  left: 9rpx;
  top: 8rpx;
  width: 15rpx;
  height: 9rpx;
  border-left: 4rpx solid #fff;
  border-bottom: 4rpx solid #fff;
  transform: rotate(-45deg);
}
.scan-glyph {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  color: inherit;
}
.scan-corner {
  position: absolute;
  width: 11rpx;
  height: 11rpx;
  border-color: currentColor;
  border-style: solid;
}
.corner-tl { left: 0; top: 0; border-width: 4rpx 0 0 4rpx; border-radius: 6rpx 0 0 0; }
.corner-tr { right: 0; top: 0; border-width: 4rpx 4rpx 0 0; border-radius: 0 6rpx 0 0; }
.corner-bl { left: 0; bottom: 0; border-width: 0 0 4rpx 4rpx; border-radius: 0 0 0 6rpx; }
.corner-br { right: 0; bottom: 0; border-width: 0 4rpx 4rpx 0; border-radius: 0 0 6rpx 0; }
.icon-profile { width: 40rpx; }
.profile-head {
  position: absolute;
  left: 13rpx;
  top: 1rpx;
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: currentColor;
}
.profile-body {
  position: absolute;
  left: 3rpx;
  bottom: 0;
  width: 34rpx;
  height: 17rpx;
  border-radius: 18rpx 18rpx 7rpx 7rpx;
  background: currentColor;
}
.icon-generic { border: 5rpx solid currentColor; border-radius: 8rpx; }
.generic-line { position: absolute; left: 6rpx; right: 6rpx; height: 3rpx; border-radius: 3rpx; background: currentColor; }
.generic-line.line-one { top: 8rpx; }
.generic-line.line-two { top: 18rpx; }
.generic-mark { position: absolute; right: -5rpx; top: -7rpx; width: 13rpx; height: 13rpx; border: 4rpx solid #fff; border-radius: 50%; background: currentColor; }
.icon-create { border-radius: 50%; }
.icon-create .generic-line.line-one { top: 14rpx; left: 6rpx; right: 6rpx; }
.icon-create .generic-line.line-two { top: 6rpx; bottom: 6rpx; left: 14rpx; width: 3rpx; height: auto; }
.icon-create .generic-mark, .icon-orders .generic-mark, .icon-workspace .generic-mark { display: none; }
.icon-shipment { border-radius: 6rpx 6rpx 12rpx 12rpx; }
.icon-installation { transform: rotate(45deg); border-radius: 4rpx 15rpx 4rpx 15rpx; }
.icon-aftersales { border-radius: 50% 50% 50% 8rpx; }
.scan-action {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: -54rpx;
  transform: translateX(-50%);
  width: 108rpx;
  height: 108rpx;
  border: 8rpx solid #f4f3f0;
  border-radius: 58rpx;
  background: #111;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 10rpx 28rpx rgba(17, 17, 17, .18);
}
.scan-glyph-light { width: 48rpx; height: 48rpx; color: #fff; }
.scan-glyph-light .scan-corner { width: 15rpx; height: 15rpx; }
.safe-bottom { height: env(safe-area-inset-bottom); background: #f4f4f2; }
