{
  "description": "苔的跟单旅程微信小程序（本地并行开发）",
  "appid": "touristappid",
  "projectname": "tai-order-journey-mini",
  "compileType": "miniprogram",
  "miniprogramRoot": "./",
  "setting": {
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "urlCheck": false,
    "checkSiteMap": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": true,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "ignoreDevUnusedFiles": false,
    "ignoreUploadUnusedFiles": false,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": [
      "typescript"
    ],
    "condition": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [
      {
        "type": "suffix",
        "value": ".webp"
      },
      {
        "type": "folder",
        "value": "tests"
      }
    ],
    "include": []
  },
  "editorSetting": {}
}
