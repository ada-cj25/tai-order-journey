DATABASE_URL=postgresql://erp_local:CHANGE_ME@127.0.0.1:5432/whole_house_erp
SESSION_SECRET=replace-with-a-long-random-secret
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
UPLOAD_ROOT=server/uploads

# 登录页只由 API 服务端读取此 Web 服务 Key；留空时安全降级为静态晴天画面。
AMAP_WEATHER_API_KEY=

# 微信小程序真实接口默认关闭；仅在主体、备案、授权与移动权限验收全部通过后改为 true。
MINI_PROGRAM_ENABLED=false
MINI_PROGRAM_DEV_LOGIN_ENABLED=false
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_OPENID_HASH_SECRET=replace-with-an-independent-32-character-secret
