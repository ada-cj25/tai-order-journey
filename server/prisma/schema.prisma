  purchaseOrderLineId String
  receiptLineId       String?
  quantity            Decimal   @db.Decimal(16, 4)
  resolution          String
  status              String    @default("OPEN")
  note                String?
  createdBy           String
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  receiptLine       GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)
}

model MaterialVersionCancellation {
  id                 String   @id @default(uuid())
  orderId            String
  materialVersionId  String
  reason             String
  supplierResolution Json?
  receivedResolution Json?
  status             String   @default("COMPLETED")
  requestedBy        String
  createdAt          DateTime @default(now())

  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  materialVersion MaterialListVersion @relation(fields: [materialVersionId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model AfterSalesCase {
  id                String    @id @default(uuid())
  orderId           String
  caseNumber        String    @unique
  status            AfterSalesStatus @default(OPEN)
  issueType         String
  description       String
  warrantyYears     Int?
  warrantyStartsAt  DateTime?
  warrantyExpiresAt DateTime?
  startedAt         DateTime?
  resolvedAt        DateTime?
  resolution        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  order       Order                @relation(fields: [orderId], references: [id])
  costBatches AfterSalesCostBatch[]
}

model AfterSalesCostBatch {
  id            String    @id @default(uuid())
  afterSalesId  String
  orderId       String
  incurredOn    DateTime
  amount        Decimal   @db.Decimal(16, 2)
  description   String
  attachmentIds Json?
  recordedBy    String
  recordedAt    DateTime  @default(now())
  voidedAt      DateTime?
  voidedBy      String?
  voidReason    String?

  afterSales AfterSalesCase @relation(fields: [afterSalesId], references: [id], onDelete: Cascade)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([afterSalesId, recordedAt])
  @@index([orderId, voidedAt])
}

model Attachment {
  id               String   @id @default(uuid())
  orderId          String
  productionAreaId String?
  category         String
  originalName     String
  storageKey       String   @unique
  storageProvider  String   @default("local")
  sha256           String?
  mimeType         String
  size             Int
  uploadedBy       String
  createdAt        DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productionArea ProductionArea? @relation(fields: [productionAreaId], references: [id], onDelete: Cascade)
}

model SecurityAudit {
  id        String   @id @default(uuid())
  actorId   String?
  targetId  String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model LoginAttempt {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime
}

model MutationReceipt {
  id          String   @id @default(uuid())
  actorId     String
  scope       String
  key         String
  fingerprint String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([actorId, scope, key])
}

model HaixunImport {
  id          String    @id @default(uuid())
  orderId     String
  version     Int
  status      String    @default("PREVIEW")
  fileName    String
  uploadedBy  String
  preview     Json
  errors      Json?
  reviewedBy  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
}
