# Copy to /etc/tai-erp/production/runtime.env, chmod 600, then replace every CHANGE_ME.
NODE_ENV=production
TZ=Asia/Shanghai
DATABASE_URL=postgresql://tai_runtime:CHANGE_ME_URL_ENCODED@db:5432/tai_erp
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
WEB_ORIGIN=https://taigenlvcheng.cn
ATTACHMENT_STORAGE=cos
COS_BUCKET=CHANGE_ME_ATTACHMENT_BUCKET-APPID
COS_REGION=ap-shanghai
COS_SECRET_ID=CHANGE_ME_APP_ONLY_SECRET_ID
COS_SECRET_KEY=CHANGE_ME_APP_ONLY_SECRET_KEY
COST_MODULE_ENABLED=false
AMAP_WEATHER_API_KEY=CHANGE_ME_TO_APPROVED_WEB_SERVICE_KEY
ICP_FILING_NUMBER=
PUBLIC_SECURITY_FILING_NUMBER=
PUBLIC_SECURITY_FILING_URL=
# This COS identity may GetObject/PutObject only in the private attachment bucket.
# It must not access the backup bucket and must not have DeleteObject permission.
