ERP_WEB_IMAGE=ccr.ccs.tencentyun.com/CHANGE_ME/tai-erp-web@sha256:REPLACE_WITH_RELEASE_DIGEST
ERP_MIGRATION_IMAGE=ccr.ccs.tencentyun.com/CHANGE_ME/tai-erp-migrate@sha256:REPLACE_WITH_RELEASE_DIGEST
