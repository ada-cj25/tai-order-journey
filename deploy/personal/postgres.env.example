# Used by the PostgreSQL container. Changing these values after the volume is
# initialized does not rotate existing database roles.
POSTGRES_DB=tai_erp
POSTGRES_USER=tai_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD
POSTGRES_INITDB_ARGS="--data-checksums --auth-host=scram-sha-256"
ERP_RUNTIME_DB_USER=tai_runtime
ERP_RUNTIME_DB_PASSWORD=CHANGE_ME_STRONG_RUNTIME_PASSWORD
