# Create separate protected files OUTSIDE the repository. No live values in source control.
NODE_ENV=production
TZ=Asia/Shanghai
DATABASE_URL=postgresql://erp_runtime:CHANGE_ME@PRIVATE_PG_HOST:5432/erp_production
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_BYTES
WEB_ORIGIN=https://erp.company.example
ATTACHMENT_STORAGE=cos
COS_BUCKET=CHANGE_ME-APPID
COS_REGION=ap-shanghai
COS_SECRET_ID=CHANGE_ME
COS_SECRET_KEY=CHANGE_ME
COST_MODULE_ENABLED=false
# Runtime DB role: DML only, no CREATE/DROP. COS role: private live bucket Get/Put only, no backup/delete permission.
# Configure verified database TLS per the cloud provider certificate; do not use rejectUnauthorized:false.
