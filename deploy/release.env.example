DEPLOYMENT_NAME=erp-staging
ERP_API_IMAGE=company-registry.example/erp-api@sha256:REPLACE_WITH_APPROVED_DIGEST
ERP_WEB_IMAGE=company-registry.example/erp-web@sha256:REPLACE_WITH_APPROVED_DIGEST
ERP_MIGRATION_IMAGE=company-registry.example/erp-migrate@sha256:REPLACE_WITH_APPROVED_DIGEST
ERP_RUNTIME_ENV_FILE=/etc/erp/staging/runtime.env
ERP_MIGRATION_ENV_FILE=/etc/erp/staging/migration.env
ERP_TLS_DIRECTORY=/etc/erp/staging/tls
ERP_HOST=staging-erp.company.example
API_HOST=staging-api.company.example
