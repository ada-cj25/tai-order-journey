limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${ERP_HOST} ${API_HOST};
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl default_server;
    server_name ${ERP_HOST} ${API_HOST};
    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 41m;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/security-headers.conf;
    # API location deliberately has no URI suffix; retain /api/... for Nest.
    location /api/ {
        include /etc/nginx/security-headers.conf;
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
        proxy_request_buffering on;
        add_header Cache-Control "no-store" always;
    }
    location = /api/v1/auth/login {
        include /etc/nginx/security-headers.conf;
        limit_req zone=login burst=120 nodelay;
        limit_req_status 429;
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }
    location /assets/ { try_files $uri =404; expires 7d; }
    location / { include /etc/nginx/security-headers.conf; try_files $uri $uri/ /index.html; add_header Cache-Control "no-cache"; }
}
